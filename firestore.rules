rules_version = '2';

// Ferrer Clothing Rental - security rules for the `ferrer-db` database.
// Roles are stored on the user document (users/{uid}.role): 'customer',
// 'admin', or 'superadmin'. Only the console creates superadmins.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isSuperAdmin();
      // The admin dashboard watches the whole collection to count users.
      allow list: if isAdmin() || isSuperAdmin();

      // Sign-up writes the caller's own profile; the role is forced to
      // customer so nobody can self-promote to admin. fullName may be
      // absent/empty (users without a display name complete it later).
      // A superadmin registering an admin writes that profile instead;
      // superadmin accounts are never creatable client-side.
      allow create: if (isOwner(uid)
        && request.resource.data.role == 'customer'
        && (!('fullName' in request.resource.data)
            || request.resource.data.fullName is string))
        || (isSuperAdmin()
            && request.resource.data.role in ['customer', 'admin']);

      // Superadmins manage roles but can never demote a fellow superadmin
      // (UI blocks it too), and can never promote a customer in place:
      // admin accounts are created fresh. Admins may edit anyone except
      // superadmins; users may edit their own profile but can never touch
      // their role.
      allow update: if (isSuperAdmin()
            && (resource.data.role != 'superadmin'
                || request.resource.data.role == 'superadmin')
            && !(resource.data.role == 'customer'
                && request.resource.data.role == 'admin'))
        || (isAdmin() && resource.data.role != 'superadmin')
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['role']));

      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.role != 'superadmin');
    }

    // ------------------------------------------------------------------
    // auditLogs (superadmin activity trail)
    // ------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow list, get: if isSuperAdmin();

      // Any signed-in user may record their own actions; the actor must
      // match the caller so nobody can forge entries for someone else.
      // Entries are append-only.
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.actorEmail is string;
    }

    // ------------------------------------------------------------------
    // items (rental catalog)
    // ------------------------------------------------------------------
    match /items/{itemId} {
      allow read: if isSignedIn();

      allow create, delete: if isAdmin();

      // Admin edits freely. Customers may only flip the `status` field
      // (available <-> rented) as part of checkout / cancel / return flows.
      // The review flow may only bump the public rating aggregate.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status']))
        || (isSignedIn()
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['avgRating', 'ratingCount']));
    }

    // Full-size item photos (data URIs) kept out of the items stream so
    // catalog lists stay light. Customers only ever read these.
    match /itemPhotos/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // rentals
    // ------------------------------------------------------------------
    match /rentals/{rentalId} {
      allow read: if isAdmin() || isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Admins manage every rental (confirm/decline requests, returns,
      // cancellations, edits). Customers may only cancel their own pending
      // or active rental. `updatedAt` is stamped by the cancel flow for the
      // activity feed; it carries no privileges.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status in ['pending', 'active']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // appointments
    // ------------------------------------------------------------------
    match /appointments/{appointmentId} {
      allow read: if isAdmin() || isSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'scheduled'];

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // slotAvailability (per-day fitting-slot holds for the booking grid)
    // ------------------------------------------------------------------
    match /slotAvailability/{day}/holds/{holdId} {
      // Anyone signed in may read holds (user ids + slot labels only).
      allow read: if isSignedIn();
      // Holds are written alongside the appointment itself, owned by the
      // booking user; staff may clean up any hold.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.slots is list;
      allow update, delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isAdmin() || isSuperAdmin());
    }

    // ------------------------------------------------------------------
    // reviews (one doc per completed rental, id = rentalId)
    // ------------------------------------------------------------------
    match /reviews/{rentalId} {
      allow read: if isSignedIn() || isSuperAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && exists(/databases/$(database)/documents/rentals/$(rentalId))
        && get(/databases/$(database)/documents/rentals/$(rentalId)).data.status == 'completed'
        && get(/databases/$(database)/documents/rentals/$(rentalId)).data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['stars', 'comment', 'updatedAt'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // conversations (one thread per customer, id = userId)
    // ------------------------------------------------------------------
    match /conversations/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSuperAdmin();

      allow create: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.keys()
                  .hasOnly([
                    'userId', 'userName', 'lastText', 'lastSenderRole',
                    'updatedAt', 'lastSeenCustomer',
                  ]));

      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'lastText', 'lastSenderRole', 'updatedAt',
                    'lastSeenCustomer',
                  ]));

      allow delete: if isAdmin();
    }

    match /conversations/{userId}/messages/{messageId} {
      allow read: if isAdmin() || isSuperAdmin()
        || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == 'customer'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000;

      allow update, delete: if isAdmin();
    }

    // Admins send in any thread as the shop identity. Kept separate so the
    // customer branch above stays a tight owner-only rule.
    match /conversations/{userId}/messages/{adminMessageId} {
      allow create: if isAdmin()
        && request.resource.data.senderRole == 'admin'
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000;
    }
  }
}
